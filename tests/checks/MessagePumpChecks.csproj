<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFrameworks>net47;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms><LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net47'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    <PackageReference Include="System.Text.Json" Version="10.0.14"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/FrameDiagnostics.cs" Link="FrameDiagnostics.cs"/>
    <Compile Include="../../src/Compat.cs" Link="Compat.cs"/>
  </ItemGroup>
</Project>
